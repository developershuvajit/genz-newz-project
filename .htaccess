<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Force HTTPS
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
    
    # Remove trailing slashes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [R=301,L]
    
    # Redirect old .php URLs to clean URLs
    RewriteRule ^index\.php$ / [R=301,L]
    RewriteRule ^login\.php$ /login [R=301,L]
    RewriteRule ^archive\.php$ /archive [R=301,L]
    
    # Route all requests to public/index.php except existing files/directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# Security - Prevent directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "\.(env|ini|log|sql|json|lock)$">
    Require all denied
</FilesMatch>

# Protect config files
<Files "config.php">
    Require all denied
</Files>

# Protect storage
<IfModule mod_rewrite.c>
    RewriteRule ^storage/ - [F,L]
</IfModule>